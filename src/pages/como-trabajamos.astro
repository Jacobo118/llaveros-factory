---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import ImageSlot from "../components/ImageSlot.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Icon from "../components/Icon.astro";
import Accordion from "../components/Accordion.astro";
import CTABanner from "../components/CTABanner.astro";
import type { FAQItem } from "../components/Accordion.astro";

const timeline = [
  { icon: "pencil", title: "Te enviamos el mockup", desc: "Diseñamos una propuesta a partir de tu logo o tu idea." },
  { icon: "check-circle", title: "Lo apruebas", desc: "Revisas el mockup y confirmas los detalles antes de fabricar." },
  { icon: "credit-card", title: "Primer pago (50%)", desc: "Al aprobar el mockup, iniciamos la producción." },
  { icon: "cog", title: "Producción (25-30 días)", desc: "Fabricamos tu pedido en nuestra propia fábrica." },
  { icon: "camera", title: "Fotos y vídeos del pedido terminado", desc: "Te mostramos el resultado antes de enviarlo." },
  { icon: "credit-card", title: "Segundo pago (50%)", desc: "Una vez confirmas que todo está correcto." },
  { icon: "truck", title: "Envío", desc: "Enviamos tu pedido directo a tu puerta, envío incluido." },
];

const faqs: FAQItem[] = [
  { question: "¿Cuál es el pedido mínimo?", answer: "El pedido mínimo es de 200 unidades." },
  { question: "¿Cuáles son los plazos de fabricación?", answer: "La producción tarda entre 25 y 30 días desde la aprobación del mockup." },
  { question: "¿Los moldes tienen coste?", answer: "No, los moldes son gratuitos, están incluidos en el precio." },
  { question: "¿El envío está incluido?", answer: "Sí, el envío va incluido en el precio final de tu pedido." },
  { question: "¿Qué formato de diseño tengo que enviar?", answer: "Preferimos vectoriales (AI, EPS, PDF o SVG), pero también podemos trabajar a partir de una imagen en buena resolución o una idea explicada por escrito." },
  { question: "¿Qué pasa si necesito más de 3.000 unidades?", answer: "Sin problema, contáctanos y te preparamos un presupuesto ajustado a tu cantidad." },
];
---

<Layout
  title="Cómo trabajamos"
  description="Descubre el proceso de fabricación de Llaveros Factory: del mockup a tu pedido terminado, con pago en 2 partes y envío incluido."
  path="/como-trabajamos"
>
  <section class="bg-ink pt-10 pb-6 sm:pt-14">
    <Container>
      <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
        <p class="label-tag">Nuestro proceso</p>
        <h1 class="text-5xl sm:text-6xl text-white">
          Cómo <span class="text-brand">trabajamos</span>
        </h1>
        <p class="text-lg text-white/70">
          Un proceso sencillo, transparente y pensado para que compruebes el
          resultado antes del pago final.
        </p>
      </div>
    </Container>
  </section>

  <section class="bg-ink pb-10">
    <Container>
      <ImageSlot
        src="/img/equipo-fabrica.png"
        label="Equipo de Llaveros Factory"
        file="equipo-fabrica.png"
        size="1905x825px"
        aspect="aspect-[16/8]"
        class="w-full rounded-2xl"
      />
    </Container>
  </section>

  <section class="bg-ink pt-4 pb-16 sm:pb-20">
    <Container>
      <SectionTitle
        tag="Paso a paso"
        titleParts={[{ text: "De tu idea al" }, { text: "producto final", brand: true }]}
        align="center"
        class="mx-auto mb-12 max-w-2xl text-center [&>h2]:mx-auto"
      />

      <div class="relative mx-auto max-w-5xl">
        <!-- línea central del timeline: color sólido, sin degradado, para
             que se vea igual de bien en todos los pasos -->
        <div class="absolute left-6 top-2 bottom-2 w-0.5 bg-brand/35 md:left-1/2 md:-translate-x-1/2"></div>

        <div class="flex flex-col gap-10 md:gap-4">
          {timeline.map((step, i) => {
            const isEven = i % 2 === 0;
            return (
              <div class="relative">
                <span class="absolute left-6 top-6 z-10 flex h-11 w-11 -translate-x-1/2 items-center justify-center rounded-full bg-brand font-display text-lg font-bold text-white ring-8 ring-ink md:left-1/2 md:top-1/2 md:-translate-y-1/2">
                  {i + 1}
                </span>

                <div class="grid grid-cols-1 md:grid-cols-2 md:items-center md:gap-x-14">
                  <div class:list={["pl-16 md:pl-0", isEven ? "" : "md:col-start-2"]}>
                    <div
                      class:list={[
                        "fade-in group rounded-2xl border border-card-border bg-card p-6 transition-all duration-200 hover:-translate-y-1 hover:border-brand sm:p-7",
                        isEven ? "md:mr-14 md:text-right" : "md:ml-14",
                      ]}
                    >
                      <div class:list={["mb-3 flex items-center gap-3", isEven ? "md:flex-row-reverse" : ""]}>
                        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-brand/15 text-brand transition-colors group-hover:bg-brand group-hover:text-white">
                          <Icon name={step.icon} class="h-6 w-6" />
                        </span>
                        <h3 class="text-xl font-bold text-white">{step.title}</h3>
                      </div>
                      <p class="text-sm text-white/60">{step.desc}</p>
                    </div>
                  </div>
                  <div class="hidden md:block"></div>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="fade-in mx-auto mt-14 max-w-3xl rounded-2xl border border-brand/30 bg-brand/10 p-7 sm:p-9">
        <div class="mb-3 flex items-center gap-3">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-brand/20 text-brand">
            <Icon name="credit-card" class="h-6 w-6" />
          </span>
          <h3 class="text-xl font-bold text-white">Pago en 2 partes</h3>
        </div>
        <p class="text-white/70">
          50% al aprobar el mockup para iniciar la producción y 50% al
          finalizar, después de recibir fotos y vídeos de tu pedido.
        </p>
        <p class="mt-3 text-lg font-semibold text-brand">
          Así puedes comprobar el resultado antes de realizar el pago final.
        </p>
        <Button href="/contacto" class="mt-6 w-fit">Pedir presupuesto</Button>
      </div>
    </Container>
  </section>

  <section class="bg-light py-16">
    <Container>
      <div class="mx-auto max-w-3xl">
        <SectionTitle
          tag="Preguntas frecuentes"
          titleParts={[{ text: "Resolvemos tus" }, { text: "dudas", brand: true }]}
          light
          align="center"
          class="mx-auto mb-10 [&>h2]:mx-auto"
        />
        <Accordion items={faqs} />
      </div>
    </Container>
  </section>

  <CTABanner
    title="¿Empezamos con tu pedido?"
    description="Hablemos. Te asesoramos y te ayudamos a hacerlo realidad."
  />
</Layout>
