---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Icon from "../components/Icon.astro";
import Accordion from "../components/Accordion.astro";
import CTABanner from "../components/CTABanner.astro";
import type { FAQItem } from "../components/Accordion.astro";

const timeline = [
  { icon: "pencil", title: "Te enviamos el mockup", desc: "Diseñamos una propuesta a partir de tu logo o tu idea." },
  { icon: "check-circle", title: "Lo apruebas", desc: "Revisas el mockup y confirmas los detalles antes de fabricar." },
  { icon: "credit-card", title: "Primer pago (50%)", desc: "Al aprobar el mockup, iniciamos la producción." },
  { icon: "cog", title: "Producción (25-30 días)", desc: "Fabricamos tu pedido en nuestra propia fábrica." },
  { icon: "camera", title: "Fotos y vídeos del pedido terminado", desc: "Te mostramos el resultado antes de enviarlo." },
  { icon: "credit-card", title: "Segundo pago (50%)", desc: "Una vez confirmas que todo está correcto." },
  { icon: "truck", title: "Envío", desc: "Enviamos tu pedido directo a tu puerta, envío incluido." },
];

const faqs: FAQItem[] = [
  { question: "¿Cuál es el pedido mínimo?", answer: "El pedido mínimo es de 200 unidades." },
  { question: "¿Cuáles son los plazos de fabricación?", answer: "La producción tarda entre 25 y 30 días desde la aprobación del mockup." },
  { question: "¿Los moldes tienen coste?", answer: "No, los moldes son gratuitos, están incluidos en el precio." },
  { question: "¿El envío está incluido?", answer: "Sí, el envío va incluido en el precio final de tu pedido." },
  { question: "¿Qué formato de diseño tengo que enviar?", answer: "Preferimos vectoriales (AI, EPS, PDF o SVG), pero también podemos trabajar a partir de una imagen en buena resolución o una idea explicada por escrito." },
  { question: "¿Qué pasa si necesito más de 3.000 unidades?", answer: "Sin problema, contáctanos y te preparamos un presupuesto ajustado a tu cantidad." },
];
---

<Layout
  title="Cómo trabajamos"
  description="Descubre el proceso de fabricación de Llaveros Factory: del mockup a tu pedido terminado, con pago en 2 partes y envío incluido."
  path="/como-trabajamos"
>
  <PageHero
    tag="Nuestro proceso"
    title="CÓMO"
    titleBrand="TRABAJAMOS"
    description="Un proceso sencillo, transparente y pensado para que compruebes el resultado antes del pago final."
    bgFile="como-trabajamos-hero-fondo.webp"
    bgLabel="Fondo de taller para cabecera de cómo trabajamos"
  />

  <section class="bg-ink">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
      <ol class="relative flex flex-col gap-10 border-l border-white/10 pl-8">
        {timeline.map((step, i) => (
          <li class="fade-in relative">
            <span class="absolute -left-[45px] flex h-8 w-8 items-center justify-center rounded-full bg-brand text-xs font-display text-white ring-4 ring-ink">
              {i + 1}
            </span>
            <div class="flex items-start gap-3">
              <span class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-card text-brand">
                <Icon name={step.icon} class="h-4 w-4" />
              </span>
              <div>
                <h3 class="text-lg text-white normal-case tracking-normal">{step.title}</h3>
                <p class="mt-1 text-sm text-white/60">{step.desc}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>

      <div class="fade-in mt-12 rounded-2xl border border-brand/30 bg-brand/10 p-6 sm:p-8">
        <div class="mb-3 flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/20 text-brand">
            <Icon name="credit-card" class="h-5 w-5" />
          </span>
          <h3 class="text-lg text-white normal-case tracking-normal">Pago en 2 partes</h3>
        </div>
        <p class="text-sm text-white/70">
          50% al aprobar el mockup para iniciar la producción y 50% al
          finalizar, después de recibir fotos y vídeos de tu pedido.
        </p>
        <p class="mt-3 font-semibold text-brand">
          Así puedes comprobar el resultado antes de realizar el pago final.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-light">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
      <SectionTitle
        tag="Preguntas frecuentes"
        titleParts={[{ text: "Resolvemos tus" }, { text: "dudas", brand: true }]}
        light
        align="center"
        class="mx-auto mb-10 [&>h2]:mx-auto"
      />
      <Accordion items={faqs} />
    </div>
  </section>

  <CTABanner
    title="¿Empezamos con tu pedido?"
    description="Hablemos. Te asesoramos y te ayudamos a hacerlo realidad."
  />
</Layout>
