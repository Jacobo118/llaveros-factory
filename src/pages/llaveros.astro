---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Icon from "../components/Icon.astro";
import ImageSlot from "../components/ImageSlot.astro";
import PriceTable from "../components/PriceTable.astro";
import CTABanner from "../components/CTABanner.astro";
import Carousel from "../components/Carousel.astro";
import { PRECIOS_LLAVEROS, PRECIOS_NOTA } from "../data/precios";

const ventajas = [
  { icon: "shield-check", title: "Resistentes", desc: "PVC de alta durabilidad, resistente al agua y al uso diario." },
  { icon: "sparkles", title: "Gran nivel de detalle", desc: "Reproducimos logos y diseños complejos con precisión." },
  { icon: "shapes", title: "Cualquier forma", desc: "Sin límite de silueta: tu diseño marca la forma final." },
  { icon: "palette", title: "Colores Pantone", desc: "Ajustamos los colores a tu identidad de marca." },
];

const usos = [
  { icon: "briefcase", title: "Marcas y negocios", desc: "Refuerza tu identidad en cada entrega a clientes." },
  { icon: "calendar-days", title: "Eventos y ferias", desc: "Un recuerdo con tu marca que la gente se lleva a casa." },
  { icon: "shopping-bag", title: "Merchandising", desc: "Producto de marca listo para vender o regalar." },
  { icon: "gift", title: "Regalos de empresa", desc: "Un detalle con tu logo para clientes y equipo." },
];

// Huecos 1-6 ya tienen foto real; 7-9 siguen pendientes (placeholder).
const llaverosGaleria = [
  "llaveros-galeria-01.png",
  "llaveros-galeria-02.png",
  "llaveros-galeria-03.png",
  "llaveros-galeria-04.png",
  "llaveros-galeria-05.png",
  "llaveros-galeria-06.png",
  "llaveros-galeria-07.jpg",
  "llaveros-galeria-08.png",
  "llaveros-galeria-09.jpg",
];
---

<Layout
  title="Llaveros de PVC personalizados"
  description="Llaveros de PVC 100% personalizados, resistentes y con gran nivel de detalle. Cualquier forma y color Pantone. Fabricación propia."
  path="/llaveros"
>
  <section class="bg-ink pt-10 pb-8 sm:pt-14">
    <Container class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center">
      <div class="fade-in flex flex-col gap-6">
        <p class="label-tag text-base sm:text-lg">Llaveros de PVC</p>
        <h1 class="text-5xl sm:text-7xl text-white">
          Llaveros <span class="text-brand">personalizados</span>
        </h1>
        <p class="max-w-lg text-xl text-white/70">
          Diseños 100% personalizados, resistentes, con gran nivel de detalle y
          todo tipo de formas.
        </p>
      </div>
      <ImageSlot
        src="/img/llaveros-intro.png"
        label="Llavero de PVC personalizado"
        file="llaveros-intro.png"
        size="433x577px (fondo transparente)"
        aspect="aspect-[4/3]"
        bare
        class="sm:scale-125"
      />
    </Container>
  </section>

  <section class="bg-ink pb-14">
    <Container>
      <Carousel id="llaveros-ventajas-carousel" class="gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {ventajas.map((v) => (
          <div class="carousel-item fade-in flex flex-col gap-3 rounded-2xl border-2 border-brand bg-card p-6 transition-all duration-200 hover:-translate-y-1">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/15 text-brand">
              <Icon name={v.icon} class="h-5 w-5" />
            </span>
            <h3 class="text-lg font-bold text-white">{v.title}</h3>
            <p class="text-sm text-white/60">{v.desc}</p>
          </div>
        ))}
      </Carousel>
    </Container>
  </section>

  <section class="bg-light py-14">
    <Container>
      <SectionTitle
        tag="Dónde se usan"
        titleParts={[{ text: "Ideas para" }, { text: "cada ocasión", brand: true }]}
        light
        align="center"
        class="mx-auto mb-10 max-w-xl text-center [&>h2]:mx-auto"
      />
      <Carousel id="llaveros-usos-carousel" light class="gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {usos.map((u) => (
          <div class="carousel-item fade-in flex flex-col items-center gap-3 rounded-2xl border-2 border-brand bg-card p-8 text-center transition-all duration-200 hover:-translate-y-1">
            <span class="flex h-16 w-16 items-center justify-center rounded-full bg-brand/15 text-brand">
              <Icon name={u.icon} class="h-8 w-8" />
            </span>
            <h3 class="text-lg font-bold text-white">{u.title}</h3>
            <p class="text-sm text-white/60">{u.desc}</p>
          </div>
        ))}
      </Carousel>
    </Container>
  </section>

  <section class="bg-ink py-14">
    <Container>
      <SectionTitle
        tag="Galería"
        titleParts={[{ text: "Llaveros que" }, { text: "hemos fabricado", brand: true }]}
        class="mb-8"
      />
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {llaverosGaleria.map((file, i) => {
          const n = String(i + 1).padStart(2, "0");
          return (
            <ImageSlot
              src={`/img/${file}`}
              label={`Llavero de ejemplo ${n}`}
              file={file}
              size="600x600px"
              aspect="aspect-square"
              class="rounded-xl border-2 border-brand"
            />
          );
        })}
      </div>
    </Container>
  </section>

  <section class="bg-light py-14">
    <Container class="text-center">
      <div class="mx-auto max-w-2xl">
        <SectionTitle
          tag="Precio directo de fábrica"
          titleParts={[{ text: "Precios por" }, { text: "cantidad", brand: true }]}
          light
          align="center"
          class="mx-auto mb-8 [&>h2]:mx-auto"
        />
        <div class="rounded-2xl bg-light-card p-6 text-left shadow-xl shadow-black/5 sm:p-8">
          <PriceTable tramos={PRECIOS_LLAVEROS} nota={PRECIOS_NOTA} />
        </div>
      </div>
    </Container>
  </section>

  <CTABanner
    title="¿Listo para tus llaveros personalizados?"
    description="Cuéntanos tu idea y te enviamos un mockup sin compromiso."
  />
</Layout>
