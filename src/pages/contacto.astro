---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import { CONTACT, SOCIAL, WEBHOOK_URL } from "../config";
import { TRAMOS_CANTIDAD_CONTACTO } from "../data/precios";

const infoItems = [
  { icon: "phone", label: CONTACT.phoneDisplay, href: CONTACT.phoneDisplay.startsWith("[PENDIENTE") ? undefined : `tel:${CONTACT.phoneDisplay}` },
  { icon: "mail", label: CONTACT.email, href: CONTACT.email.startsWith("[PENDIENTE") ? undefined : `mailto:${CONTACT.email}` },
  { icon: "map-pin", label: CONTACT.address, href: undefined },
];
---

<Layout
  title="Contacto"
  description="Pide tu presupuesto de llaveros o imanes de PVC personalizados. Te respondemos con un mockup sin compromiso."
  path="/contacto"
>
  <PageHero
    tag="Contacto"
    title="PIDE TU"
    titleBrand="PRESUPUESTO"
    description="Cuéntanos tu idea y te preparamos una propuesta a medida, sin compromiso."
    bgFile="contacto-hero-fondo.webp"
    bgLabel="Fondo de taller para cabecera de contacto"
  />

  <section class="bg-ink">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-5 lg:px-8">
      <div class="lg:col-span-2 flex flex-col gap-6">
        <div class="flex flex-col gap-4">
          {infoItems.map((item) => (
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-card text-brand">
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              {item.href ? (
                <a href={item.href} class="mt-2 text-white/80 hover:text-white">{item.label}</a>
              ) : (
                <span class="mt-2 text-white/80">{item.label}</span>
              )}
            </div>
          ))}
        </div>

        <div class="flex gap-4 pt-2">
          {[
            { name: "instagram", href: SOCIAL.instagram, label: "Instagram" },
            { name: "linkedin", href: SOCIAL.linkedin, label: "LinkedIn" },
            { name: "youtube", href: SOCIAL.youtube, label: "YouTube" },
          ].map((s) =>
            s.href ? (
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="flex h-10 w-10 items-center justify-center rounded-full bg-card text-white/70 hover:text-brand">
                <Icon name={s.name} class="h-5 w-5" />
              </a>
            ) : (
              <span title={`[PENDIENTE: URL de ${s.label}]`} class="flex h-10 w-10 items-center justify-center rounded-full bg-card text-white/25">
                <Icon name={s.name} class="h-5 w-5" />
              </span>
            )
          )}
        </div>

        <a
          href={CONTACT.whatsappNumber ? `https://wa.me/${CONTACT.whatsappNumber}` : "#"}
          class="mt-2 inline-flex w-fit items-center gap-3 rounded-xl bg-[#25D366]/10 px-5 py-3 text-sm font-semibold text-[#25D366]"
        >
          <Icon name="message-circle" class="h-5 w-5" />
          Escríbenos por WhatsApp
        </a>
      </div>

      <form id="contact-form" class="lg:col-span-3 flex flex-col gap-5 rounded-2xl border border-card-border bg-card p-6 sm:p-8" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="flex flex-col gap-2 text-sm text-white/70">
            Nombre *
            <input required name="nombre" type="text" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand" />
          </label>
          <label class="flex flex-col gap-2 text-sm text-white/70">
            Email *
            <input required name="email" type="email" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand" />
          </label>
          <label class="flex flex-col gap-2 text-sm text-white/70">
            Teléfono *
            <input required name="telefono" type="tel" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand" />
          </label>
          <label class="flex flex-col gap-2 text-sm text-white/70">
            Empresa (opcional)
            <input name="empresa" type="text" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand" />
          </label>
          <label class="flex flex-col gap-2 text-sm text-white/70">
            Producto *
            <select required name="producto" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand">
              <option value="">Selecciona una opción</option>
              <option value="Llaveros">Llaveros</option>
              <option value="Imanes">Imanes</option>
              <option value="Ambos">Ambos</option>
            </select>
          </label>
          <label class="flex flex-col gap-2 text-sm text-white/70">
            Cantidad *
            <select required name="cantidad" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand">
              <option value="">Selecciona una opción</option>
              {TRAMOS_CANTIDAD_CONTACTO.map((t) => <option value={t}>{t}</option>)}
            </select>
          </label>
        </div>

        <label class="flex flex-col gap-2 text-sm text-white/70">
          Mensaje
          <textarea name="mensaje" rows="4" class="rounded-lg border border-white/15 bg-ink px-4 py-3 text-white outline-none focus:border-brand"></textarea>
        </label>

        <label class="flex flex-col gap-2 text-sm text-white/70">
          Subir diseño (imagen o PDF)
          <input name="diseno" type="file" accept="image/*,application/pdf" class="rounded-lg border border-dashed border-white/20 bg-ink px-4 py-3 text-white/60 file:mr-4 file:rounded-full file:border-0 file:bg-brand file:px-4 file:py-2 file:text-xs file:font-bold file:uppercase file:text-white" />
        </label>

        <button
          type="submit"
          id="submit-btn"
          class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-bold uppercase tracking-wide text-white transition-all hover:bg-brand-dark disabled:opacity-60"
        >
          <span id="submit-label">Enviar solicitud</span>
          <Icon name="arrow-right" class="h-4 w-4" />
        </button>

        <p id="form-status" class="hidden text-sm" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ WEBHOOK_URL }}>
  const form = document.getElementById("contact-form");
  const btn = document.getElementById("submit-btn");
  const label = document.getElementById("submit-label");
  const status = document.getElementById("form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status || !btn || !label) return;

    if (!WEBHOOK_URL) {
      status.textContent =
        "El formulario aún no está conectado a un webhook. [PENDIENTE: URL del webhook en src/config.ts]";
      status.className = "text-sm text-brand";
      status.classList.remove("hidden");
      return;
    }

    btn.setAttribute("disabled", "true");
    label.textContent = "Enviando...";
    status.classList.add("hidden");

    try {
      const formData = new FormData(form);
      const res = await fetch(WEBHOOK_URL, { method: "POST", body: formData });
      if (!res.ok) throw new Error("request-failed");

      label.textContent = "Enviado ✓";
      status.textContent = "Gracias, hemos recibido tu solicitud. Te responderemos muy pronto.";
      status.className = "text-sm text-green-400";
      status.classList.remove("hidden");
      form.reset();
    } catch (err) {
      label.textContent = "Enviar solicitud";
      status.textContent = "No se pudo enviar el formulario. Inténtalo de nuevo o escríbenos por WhatsApp.";
      status.className = "text-sm text-brand";
      status.classList.remove("hidden");
    } finally {
      btn.removeAttribute("disabled");
    }
  });
</script>
