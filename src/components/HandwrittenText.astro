---
// Frase manuscrita con subrayado a pincel (SVG), estilo "Más que llaveros".
// Admite una o varias líneas (lines) además de un texto simple (text).
interface Props {
  text?: string;
  lines?: string[];
  class?: string;
  tilt?: boolean;
}

const { text, lines, class: className = "", tilt = false } = Astro.props;
const rows = lines ?? (text ? [text] : []);
---

<span class={`inline-block ${tilt ? "-rotate-3" : ""} ${className}`}>
  <span class="relative inline-block font-hand leading-tight text-2xl sm:text-3xl text-white">
    {rows.map((row) => <span class="block">{row}</span>)}
    <svg
      class="absolute -bottom-2 left-0 w-full"
      height="10"
      viewBox="0 0 200 10"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M2 6 C 40 2, 80 9, 120 4 C 150 1, 175 7, 198 3"
        fill="none"
        stroke="#E3131B"
        stroke-width="4"
        stroke-linecap="round"
      ></path>
    </svg>
  </span>
</span>
