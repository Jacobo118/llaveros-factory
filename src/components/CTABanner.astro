---
import Button from "./Button.astro";
import Container from "./Container.astro";

interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  title,
  description,
  ctaLabel = "Pedir presupuesto",
  ctaHref = "/contacto",
} = Astro.props;
---

<section class="border-t border-white/10 bg-ink">
  <Container class="flex flex-col items-start gap-6 py-10 md:flex-row md:items-center md:justify-between">
    <div class="max-w-xl">
      <h2 class="text-2xl sm:text-3xl text-white">{title}</h2>
      <p class="mt-2 text-white/60">{description}</p>
    </div>
    <Button href={ctaHref} class="shrink-0">{ctaLabel}</Button>
  </Container>
</section>
