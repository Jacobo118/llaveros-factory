---
interface Props {
  tag: string;
  titleParts: { text: string; brand?: boolean; break?: boolean }[];
  as?: "h1" | "h2" | "h3";
  light?: boolean;
  align?: "left" | "center";
  class?: string;
  large?: boolean;
}

const {
  tag,
  titleParts,
  as: Tag = "h2",
  light = false,
  align = "left",
  class: className = "",
  large = false,
} = Astro.props;

const alignClass = align === "center" ? "text-center items-center" : "text-left items-start";
const titleColor = light ? "text-ink" : "text-white";
const labelSize = large ? "text-base sm:text-lg" : "";
const headingSize = large
  ? "text-5xl sm:text-6xl md:text-[4rem]"
  : "text-4xl sm:text-5xl md:text-[3.25rem]";
---

<div class={`flex flex-col gap-3 ${alignClass} ${className}`}>
  <p class={`label-tag ${labelSize}`}>{tag}</p>
  <Tag class={`${headingSize} ${titleColor}`}>
    {titleParts.map((part) => (
      <>
        {part.break && <br />}
        <span class={part.brand ? "text-brand" : undefined}>{part.text} </span>
      </>
    ))}
  </Tag>
</div>
