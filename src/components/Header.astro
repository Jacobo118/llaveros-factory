---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import ImageSlot from "./ImageSlot.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/llaveros", label: "Llaveros" },
  { href: "/imanes", label: "Imanes" },
  { href: "/como-trabajamos", label: "Cómo trabajamos" },
  { href: "/sobre-nosotros", label: "Sobre nosotros" },
  { href: "/contacto", label: "Contacto" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header id="site-header" class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 backdrop-blur transition-shadow">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 shrink-0" aria-label={`${"Llaveros Factory"} — inicio`}>
      <ImageSlot
        src="/img/logo.svg"
        label="Logo Llaveros Factory"
        file="logo.svg"
        size="200x200px"
        aspect="aspect-square"
        class="h-12 w-12 rounded-full"
        loading="eager"
        compact
      />
      <span class="hidden text-sm font-display uppercase leading-none text-white sm:block">
        Llaveros<br /><span class="text-brand">Factory</span>
      </span>
    </a>

    <nav class="hidden lg:flex lg:items-center lg:gap-7" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-xs font-bold uppercase tracking-wide text-white/80 transition-colors hover:text-white",
            { "text-white border-b-2 border-brand pb-1": isActive(link.href) },
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden lg:block">
      <Button href="/contacto" class="!px-5 !py-2.5 text-xs">Pedir presupuesto</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex items-center justify-center rounded-md p-2 text-white lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <Icon name="menu" class="h-7 w-7" />
    </button>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-ink lg:hidden"
  >
    <nav class="flex flex-col gap-1 px-4 py-4" aria-label="Navegación móvil">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-md px-3 py-3 text-sm font-bold uppercase tracking-wide text-white/85",
            { "bg-white/5 text-white border-l-4 border-brand": isActive(link.href) },
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <Button href="/contacto" class="mt-2 w-full">Pedir presupuesto</Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
  });

  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add("shadow-lg", "shadow-black/40");
    } else {
      header.classList.remove("shadow-lg", "shadow-black/40");
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
