---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import ImageSlot from "./ImageSlot.astro";
import Container from "./Container.astro";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

const links = [
  { href: "/", label: "Inicio" },
  { href: "/llaveros", label: "Llaveros" },
  { href: "/imanes", label: "Imanes" },
  { href: "/como-trabajamos", label: "Cómo trabajamos" },
  { href: "/contacto", label: "Contacto" },
];

function isActive(href: string) {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
}
---

<header id="site-header" class="sticky top-0 z-50 border-b border-white/10 bg-ink/95 backdrop-blur transition-shadow">
  <!--
    Grid de 3 columnas (1fr / auto / 1fr): logo y botón se quedan cada uno
    en su lado, y el nav (columna central) queda SIEMPRE centrado de verdad
    en el header, sin importar que logo y botón tengan anchos distintos.
  -->
  <Container class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 py-2">
    <a href="/" class="flex shrink-0 items-center justify-self-start" aria-label="Llaveros Factory — inicio">
      <ImageSlot
        src="/img/logo_llavero.jpg"
        label="Logo Llaveros Factory"
        file="logo_llavero.jpg"
        size="1024x1024px"
        aspect="aspect-square"
        class="h-16 w-16 rounded-full sm:h-20 sm:w-20"
        loading="eager"
        compact
      />
    </a>

    <nav class="hidden justify-self-center xl:flex xl:items-center xl:gap-9" aria-label="Navegación principal">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "text-base font-bold uppercase tracking-wide text-white/80 transition-colors hover:text-white",
            { "text-white border-b-2 border-brand pb-1": isActive(link.href) },
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="col-start-3 flex items-center justify-self-end">
      <div class="hidden xl:block">
        <Button href="/contacto" class="!px-6 !py-3 text-sm">Pedir presupuesto</Button>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="flex items-center justify-center rounded-md p-2 text-white xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="h-7 w-7" />
      </button>
    </div>
  </Container>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-ink xl:hidden"
  >
    <nav class="flex flex-col gap-1 px-4 py-4" aria-label="Navegación móvil">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-md px-3 py-3 text-base font-bold uppercase tracking-wide text-white/85",
            { "bg-white/5 text-white border-l-4 border-brand": isActive(link.href) },
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <Button href="/contacto" class="mt-2 w-full">Pedir presupuesto</Button>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
  });

  const header = document.getElementById("site-header");
  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add("shadow-lg", "shadow-black/40");
    } else {
      header.classList.remove("shadow-lg", "shadow-black/40");
    }
  };
  document.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
