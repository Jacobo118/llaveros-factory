---
import type { Tramo } from "../data/precios";

interface Props {
  tramos: Tramo[];
  nota?: string;
}

const { tramos, nota } = Astro.props;
---

<div class="flex flex-col gap-2.5">
  {tramos.map((tramo) => (
    <div class="flex items-center justify-between rounded-xl bg-light px-5 py-3">
      <span class="font-semibold text-ink">{tramo.cantidad}</span>
      <span class="flex items-center gap-3">
        <span class="text-black/30">→</span>
        <span class="font-bold text-ink">{tramo.precioUd}</span>
      </span>
    </div>
  ))}
</div>
{nota && <p class="mt-4 text-sm text-black/50">{nota}</p>}
