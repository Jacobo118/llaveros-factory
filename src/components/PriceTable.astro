---
import type { Tramo } from "../data/precios";

interface Props {
  tramos: Tramo[];
  nota?: string;
}

const { tramos, nota } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-black/10">
  {tramos.map((tramo, i) => (
    <div
      class:list={[
        "flex items-center justify-between px-5 py-4",
        i % 2 === 0 ? "bg-black/[0.03]" : "bg-transparent",
      ]}
    >
      <span class="font-semibold text-ink">{tramo.cantidad}</span>
      <span class="flex items-center gap-2 text-ink">
        <span class="text-black/30">→</span>
        <span class="font-display text-lg text-brand">{tramo.precioUd}</span>
      </span>
    </div>
  ))}
</div>
{nota && <p class="mt-4 text-sm text-black/50">{nota}</p>}
