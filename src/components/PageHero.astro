---
// Cabecera tipo hero reducido para páginas internas.
import ImageSlot from "./ImageSlot.astro";

interface Props {
  tag: string;
  title: string;
  titleBrand?: string;
  description?: string;
  bgFile: string;
  bgLabel: string;
}

const { tag, title, titleBrand, description, bgFile, bgLabel } = Astro.props;
---

<section class="relative overflow-hidden bg-ink">
  <ImageSlot
    src={`/img/${bgFile}`}
    label={bgLabel}
    file={bgFile}
    size="1920x800px"
    aspect="aspect-auto"
    class="absolute inset-0 h-full w-full"
    loading="eager"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/90 to-ink/60"></div>

  <div class="relative mx-auto flex max-w-7xl flex-col gap-4 px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
    <p class="label-tag">{tag}</p>
    <h1 class="max-w-2xl text-4xl sm:text-5xl text-white">
      {title} {titleBrand && <span class="text-brand">{titleBrand}</span>}
    </h1>
    {description && <p class="max-w-xl text-white/70">{description}</p>}
  </div>
</section>
