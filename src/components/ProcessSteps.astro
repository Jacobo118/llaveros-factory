---
import Icon from "./Icon.astro";

export type Step = {
  number: string;
  icon: string;
  title: string;
  description: string;
};

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step, i) => (
    <div class="relative">
      <div class="fade-in flex h-full flex-col gap-4 rounded-2xl bg-light-card p-6 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg sm:p-7">
        <div class="flex items-center gap-3">
          <span class="font-display text-4xl font-bold text-brand sm:text-5xl">{step.number}</span>
          <Icon name={step.icon} class="h-9 w-9 text-brand" />
        </div>
        <h3 class="text-lg font-bold text-ink">{step.title}</h3>
        <p class="text-sm text-black/60">{step.description}</p>
      </div>
      {i < steps.length - 1 && (
        <span class="pointer-events-none absolute top-1/2 -right-4 z-10 hidden -translate-y-1/2 text-brand lg:block" aria-hidden="true">
          <Icon name="chevron-right" class="h-7 w-7" />
        </span>
      )}
    </div>
  ))}
</div>
