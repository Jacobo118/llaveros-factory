---
import Icon from "./Icon.astro";

export type Step = {
  number: string;
  icon: string;
  title: string;
  description: string;
};

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  {steps.map((step, i) => (
    <div class="relative">
      <div class="fade-in flex h-full flex-col gap-3 rounded-2xl border border-black/10 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-1 hover:border-brand hover:shadow-md">
        <span class="font-display text-3xl text-black/15">{step.number}</span>
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/10 text-brand">
          <Icon name={step.icon} class="h-5 w-5" />
        </span>
        <h3 class="font-display text-lg text-ink normal-case tracking-normal">{step.title}</h3>
        <p class="text-sm text-black/60">{step.description}</p>
      </div>
      {i < steps.length - 1 && (
        <span class="pointer-events-none absolute top-1/2 -right-4 z-10 hidden -translate-y-1/2 text-brand lg:block" aria-hidden="true">
          <Icon name="chevron-right" class="h-6 w-6" />
        </span>
      )}
    </div>
  ))}
</div>
